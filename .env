# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-value

# Database (SQLite by default; point at Postgres in production, e.g.
# postgresql://user:password@localhost:5432/finance_advisor)
DATABASE_URL=sqlite:///finance.db

# AI Advisor (Gemini). Leave blank to run entirely on the deterministic
# heuristic fallback engine — the app is fully functional either way.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
